{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "INFO Desktop",
  "version": "0.1.5",
  "identifier": "com.romanzavada.info-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "INFO Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 Roman Zavada (Роман Завада). All rights reserved."
  }
}
